#!/usr/bin/env python3
"""Simple Raspberry Pi command-line dashboard. Stdlib only."""
import os
import shutil
import signal
import socket
import sys
import time
from pathlib import Path

REFRESH = 1.0  # seconds

# ANSI helpers
ESC = "\033["
RESET = f"{ESC}0m"
BOLD = f"{ESC}1m"
DIM = f"{ESC}2m"
CLEAR = f"{ESC}2J{ESC}H"
HIDE_CUR = f"{ESC}?25l"
SHOW_CUR = f"{ESC}?25h"


def color(n):
    return f"{ESC}38;5;{n}m"


CYAN = color(45)
GREEN = color(35)
YELLOW = color(220)
ORANGE = color(208)
RED = color(196)
GREY = color(244)
BLUE = color(75)
PURPLE = color(141)


def bar(pct, width=30):
    pct = max(0.0, min(100.0, pct))
    filled = int(round(width * pct / 100))
    if pct < 60:
        c = GREEN
    elif pct < 80:
        c = YELLOW
    elif pct < 90:
        c = ORANGE
    else:
        c = RED
    return f"{c}{'█' * filled}{GREY}{'░' * (width - filled)}{RESET}"


def fmt_bytes(n):
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024:
            return f"{n:6.1f}{unit}"
        n /= 1024
    return f"{n:6.1f}P"


def fmt_uptime(secs):
    secs = int(secs)
    d, secs = divmod(secs, 86400)
    h, secs = divmod(secs, 3600)
    m, _ = divmod(secs, 60)
    if d:
        return f"{d}d {h}h {m}m"
    if h:
        return f"{h}h {m}m"
    return f"{m}m"


def read_cpu_stats():
    """Return list of (name, idle, total) per CPU line in /proc/stat."""
    rows = []
    with open("/proc/stat") as f:
        for line in f:
            if not line.startswith("cpu"):
                break
            parts = line.split()
            name = parts[0]
            vals = list(map(int, parts[1:]))
            idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
            total = sum(vals)
            rows.append((name, idle, total))
    return rows


def cpu_usage(prev, curr):
    """Return list of percentages aligned with curr rows."""
    out = []
    prev_map = {r[0]: r for r in prev}
    for name, idle, total in curr:
        p = prev_map.get(name)
        if not p:
            out.append(0.0)
            continue
        d_idle = idle - p[1]
        d_total = total - p[2]
        out.append(100.0 * (1 - d_idle / d_total) if d_total > 0 else 0.0)
    return out


def read_meminfo():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, _, rest = line.partition(":")
            info[k] = int(rest.strip().split()[0]) * 1024
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", info.get("MemFree", 0))
    used = total - avail
    sw_total = info.get("SwapTotal", 0)
    sw_free = info.get("SwapFree", 0)
    sw_used = sw_total - sw_free
    return total, used, avail, sw_total, sw_used


def read_temp():
    try:
        with open("/sys/class/thermal/thermal_zone0/temp") as f:
            return int(f.read().strip()) / 1000.0
    except Exception:
        return None


def read_cpu_freq():
    try:
        with open("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq") as f:
            return int(f.read().strip()) / 1000.0  # MHz
    except Exception:
        return None


def read_loadavg():
    with open("/proc/loadavg") as f:
        return list(map(float, f.read().split()[:3]))


def read_uptime():
    with open("/proc/uptime") as f:
        return float(f.read().split()[0])


def read_net():
    """Return dict iface -> (rx_bytes, tx_bytes), skipping loopback."""
    out = {}
    with open("/proc/net/dev") as f:
        next(f)
        next(f)
        for line in f:
            name, _, rest = line.partition(":")
            name = name.strip()
            if name == "lo":
                continue
            parts = rest.split()
            out[name] = (int(parts[0]), int(parts[8]))
    return out


def get_disks():
    """Return list of (mount, total, used, pct) for interesting filesystems."""
    seen = set()
    rows = []
    with open("/proc/mounts") as f:
        for line in f:
            dev, mount, fstype, *_ = line.split()
            if fstype in ("tmpfs", "devtmpfs", "proc", "sysfs", "cgroup", "cgroup2",
                          "pstore", "bpf", "tracefs", "debugfs", "securityfs",
                          "configfs", "fusectl", "mqueue", "hugetlbfs", "autofs",
                          "binfmt_misc", "rpc_pipefs", "fuse.gvfsd-fuse", "overlay",
                          "ramfs", "nsfs"):
                continue
            if not dev.startswith(("/dev/", "/")) or dev in seen:
                continue
            seen.add(dev)
            try:
                u = shutil.disk_usage(mount)
            except Exception:
                continue
            if u.total == 0:
                continue
            rows.append((mount, u.total, u.used, 100.0 * u.used / u.total))
    rows.sort(key=lambda r: -r[1])
    return rows


def get_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "?"


def get_pi_model():
    try:
        with open("/proc/device-tree/model") as f:
            return f.read().rstrip("\x00").strip()
    except Exception:
        return "Linux"


def term_size():
    try:
        s = shutil.get_terminal_size()
        return s.columns, s.lines
    except Exception:
        return 80, 24


def main():
    if not sys.stdout.isatty():
        print("pidash: refusing to run without a TTY", file=sys.stderr)
        return 1

    running = True

    def stop(*_):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    sys.stdout.write(HIDE_CUR + CLEAR)
    sys.stdout.flush()

    prev_cpu = read_cpu_stats()
    prev_net = read_net()
    prev_t = time.monotonic()
    time.sleep(0.2)

    model = get_pi_model()
    hostname = socket.gethostname()

    try:
        while running:
            cols, _ = term_size()
            now = time.monotonic()
            dt = max(now - prev_t, 1e-6)

            curr_cpu = read_cpu_stats()
            cpu_pcts = cpu_usage(prev_cpu, curr_cpu)
            prev_cpu = curr_cpu

            curr_net = read_net()
            net_rates = {}
            for iface, (rx, tx) in curr_net.items():
                p = prev_net.get(iface, (rx, tx))
                net_rates[iface] = ((rx - p[0]) / dt, (tx - p[1]) / dt)
            prev_net = curr_net
            prev_t = now

            mem_total, mem_used, mem_avail, sw_total, sw_used = read_meminfo()
            temp = read_temp()
            freq = read_cpu_freq()
            load = read_loadavg()
            up = read_uptime()
            disks = get_disks()
            ip = get_ip()

            out = [CLEAR]
            line = f"{BOLD}{CYAN}{model}{RESET}  {GREY}{hostname} · {ip} · up {fmt_uptime(up)}{RESET}"
            out.append(line + "\n")
            out.append(f"{GREY}{'─' * min(cols, 80)}{RESET}\n")

            # CPU section
            overall = cpu_pcts[0] if cpu_pcts else 0.0
            cores = cpu_pcts[1:]
            tline = ""
            if temp is not None:
                tc = GREEN if temp < 60 else YELLOW if temp < 70 else ORANGE if temp < 80 else RED
                tline += f"  {tc}{temp:5.1f}°C{RESET}"
            if freq is not None:
                tline += f"  {GREY}{freq:>4.0f} MHz{RESET}"
            out.append(f"{BOLD}CPU{RESET}  {bar(overall, 30)} {overall:5.1f}%{tline}\n")
            for i, p in enumerate(cores):
                out.append(f" core {i} {bar(p, 30)} {p:5.1f}%\n")
            out.append(f"{GREY}load  {load[0]:.2f}  {load[1]:.2f}  {load[2]:.2f}{RESET}\n")
            out.append("\n")

            # Memory
            mem_pct = 100.0 * mem_used / mem_total if mem_total else 0
            out.append(
                f"{BOLD}MEM{RESET}  {bar(mem_pct, 30)} {mem_pct:5.1f}%   "
                f"{fmt_bytes(mem_used)} / {fmt_bytes(mem_total)}"
                f"  {GREY}avail {fmt_bytes(mem_avail)}{RESET}\n"
            )
            if sw_total > 0:
                sw_pct = 100.0 * sw_used / sw_total
                out.append(
                    f"{BOLD}SWP{RESET}  {bar(sw_pct, 30)} {sw_pct:5.1f}%   "
                    f"{fmt_bytes(sw_used)} / {fmt_bytes(sw_total)}\n"
                )
            out.append("\n")

            # Disks
            out.append(f"{BOLD}DISK{RESET}\n")
            for mount, total, used, pct in disks[:5]:
                name = mount if len(mount) <= 14 else mount[:13] + "…"
                out.append(
                    f" {name:<14} {bar(pct, 22)} {pct:5.1f}%  "
                    f"{fmt_bytes(used)} / {fmt_bytes(total)}\n"
                )
            out.append("\n")

            # Network
            out.append(f"{BOLD}NET{RESET}\n")
            for iface, (rx, tx) in sorted(net_rates.items()):
                out.append(
                    f" {iface:<10} {BLUE}↓ {fmt_bytes(rx)}/s{RESET}   "
                    f"{PURPLE}↑ {fmt_bytes(tx)}/s{RESET}\n"
                )

            out.append(f"\n{GREY}q or Ctrl-C to quit · refresh {REFRESH:.1f}s{RESET}\n")

            sys.stdout.write("".join(out))
            sys.stdout.flush()
            time.sleep(REFRESH)
    finally:
        sys.stdout.write(SHOW_CUR + "\n")
        sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
